<Window x:Class="Embroidery.Wpf.SettingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Embroidery.Wpf"
        mc:Ignorable="d"
        Title="Настройки" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
        <Grid Margin="20" Width="420">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Папка сохранений -->
            <TextBlock Grid.Row="0"
                    Text="Папка сохранений"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>

            <Button Grid.Row="1"
                    Content="Выбрать папку"
                    Click="ChooseProjectSaves_Click"
                    Height="32"
                    HorizontalAlignment="Stretch"/>

            <TextBlock Grid.Row="2"
                    Name="SelectFolderSaves"
                    Text="Выбрана папка:"
                    Margin="0,6,0,20"
                    Foreground="Gray"
                    TextWrapping="Wrap"/>

            <!-- Папка резервных копий -->
            <TextBlock Grid.Row="3"
                    Text="Папка резервных копий"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,0,8"/>

            <Button Grid.Row="4"
                    Content="Выбрать папку"
                    Click="ChooseBackup_Click"
                    Height="32"
                    HorizontalAlignment="Stretch"/>

            <TextBlock Grid.Row="5"
                    Name="SelectFolderBackup"
                    Text="Выбрана папка:"
                    Margin="0,6,0,20"
                    Foreground="Gray"
                    TextWrapping="Wrap"/>

            <!-- Кнопки управления -->
            <Button Grid.Row="6"
                    Content="Отмена"
                    IsCancel="True"
                    MinWidth="90"
                    Height="32"
                    HorizontalAlignment="Right"/>

            <Button Grid.Row="7"
                    Content="Сохранить"
                    Click="Save_Click"
                    MinWidth="90"
                    Height="32"
                    HorizontalAlignment="Right"/>
        </Grid>
</Window>