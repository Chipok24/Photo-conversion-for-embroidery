<Window x:Class="Embroidery.Wpf.ImportImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Embroidery.Wpf"
        mc:Ignorable="d"
        Title="Созадние схемы" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
        <Grid Margin="20" Width="340">
            <Grid.RowDefinitions>
                <!-- Параметры -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

                <!-- Выбор изображения -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>

                <!-- Кнопки -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Высота -->
            <TextBlock Grid.Row="0"
                    Grid.Column="0"
                    Text="Высота (см)"
                    VerticalAlignment="Center"
                    Margin="0,0,15,10"/>

            <TextBox Grid.Row="0"
                    Grid.Column="1"
                    Name="HeightSMBox"
                    Margin="0,0,0,10"
                    Padding="5"/>

            <!-- Ширина -->
            <TextBlock Grid.Row="1"
                    Grid.Column="0"
                    Text="Ширина (см)"
                    VerticalAlignment="Center"
                    Margin="0,0,15,10"/>

            <TextBox Grid.Row="1"
                    Grid.Column="1"
                    Name="WidthSMBox"
                    Margin="0,0,0,10"
                    Padding="5"/>

            <!-- Количество цветов -->
            <TextBlock Grid.Row="2"
                    Grid.Column="0"
                    Text="Количество цветов"
                    VerticalAlignment="Center"
                    Margin="0,0,15,15"/>

            <TextBox Grid.Row="2"
                    Grid.Column="1"
                    Name="ColorCountBox"
                    Margin="0,0,0,15"
                    Padding="5"/>

            <!-- Выбор изображения -->
            <Button Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Content="Выбрать изображение"
                    Click="ChooseImage_Click"
                    Height="34"
                    Margin="0,0,0,10"/>

            <!-- Предварительный просмотр -->
            <Border Grid.Row="4"
                    Grid.ColumnSpan="2"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="5"
                    Margin="0,0,0,15">

                <Image x:Name="SelectImage"
                    Source=""
                    Stretch="Uniform"/>
            </Border>

            <!-- Кнопки управления -->
            <StackPanel Grid.Row="5"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Создать"
                        IsDefault="True"
                        Click="Accept_Click"
                        MinWidth="85"
                        Height="32"
                        Margin="0,0,10,0"/>

                <Button Content="Отмена"
                        IsCancel="True"
                        MinWidth="85"
                        Height="32"/>
            </StackPanel>
        </Grid>
</Window>