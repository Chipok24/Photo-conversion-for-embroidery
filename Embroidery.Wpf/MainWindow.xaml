<Window x:Class="Embroidery.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Embroidery.Wpf"
        xmlns:controls="clr-namespace:Embroidery.Wpf.Controls"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="800">
        <Grid Background="#F5F5F5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Панель инструментов -->
            <ToolBar Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Height="45"
                    VerticalAlignment="Center"
                    Background="#FFFFFF">

                <Button Content="Настройки"
                        Click="Button_Setting"
                        Padding="10,5"
                        Margin="2"/>

                <Separator/>

                <Button Content="Сохранить"
                        Click="Button_Save"
                        Padding="10,5"
                        Margin="2"/>

                <Button Content="Загрузить изображение"
                        Click="Button_Open"
                        Padding="10,5"
                        Margin="2"/>

            </ToolBar>

            <!-- Рабочая область -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="White"
                    Margin="5"
                    BorderBrush="#DADADA"
                    BorderThickness="1">

                <controls:PatternCanvas x:Name="PatternViewCanvas"/>

            </Border>

            <!-- Разделитель -->
            <GridSplitter Grid.Row="1"
                        Grid.Column="1"
                        Width="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        ShowsPreview="False"
                        Background="#D0D0D0"/>

            <!-- Боковая панель -->
            <Grid Grid.Row="1"
                Grid.Column="2"
                Margin="5">

                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Список проектов -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#DADADA"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,5">

                    <DockPanel>

                        <TextBlock Text="Проекты"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Margin="10,8"
                                DockPanel.Dock="Top"/>

                        <ListBox Name="Projects"
                                SelectionChanged="ProjectsListBox_SelectionChanged"
                                BorderThickness="0"
                                Margin="5"/>

                    </DockPanel>

                </Border>

                <!-- Информация о нитях -->
                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#DADADA"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,5,0,0">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">

                        <controls:ThreadInfo x:Name="ThreadInfoView"/>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Grid>
</Window>
